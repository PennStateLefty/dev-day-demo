            "$ref": "#/$defs/PartObservation"
          },
          "maxItems": 20,
          "title": "Parts",
          "type": "array"
        },
        "statementComparison": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Statementcomparison",
          "type": "string"
        },
        "limitations": {
          "items": {
