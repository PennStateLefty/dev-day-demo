          "type": "string"
        },
        "damage": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Damage",
          "type": "string"
        },
        "severity": {
          "enum": [
            "minor",
            "moderate",
            "severe",
            "unknown"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "part",
        "damage",
        "severity"
      ],
      "title": "PartObservation",
      "type": "object"
    },
    "VisionObservations": {
      "additionalProperties": false,
      "properties": {
