# Local fixture mode does not need application environment variables.
# These deployment inputs belong in ignored azd environment settings.
# This file is a reference, not automatically loaded by the application or azd.
# Do not commit real identity/contact information, deployment outputs, or credentials.
AZURE_ENV_NAME=claims-demo
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=centralus
# Explicitly select public-demo only for an authorized identity-only public demo.
AZURE_NETWORK_MODE=enforced-perimeter
# Required only for enforced-perimeter: one public IPv4 /32, never a broad CIDR.
AZURE_OPERATOR_IPV4_CIDR=
# Tenant-local Entra object ID used for SQL administration and data-plane setup.
AZURE_OPERATOR_PRINCIPAL_ID=
AZURE_SQL_ADMINISTRATOR_NAME=
AZURE_SQL_ADMINISTRATOR_TYPE=User
AZURE_APIM_PUBLISHER_NAME=
AZURE_APIM_PUBLISHER_EMAIL=
SECURITY_EXCEPTION_OWNER=
# Explicit future YYYY-MM-DD; this is metadata, not automated exception removal.
SECURITY_EXCEPTION_EXPIRES_ON=

# Hosted API registration must issue v2 Entra tokens for this client GUID audience.
# Callers require claims.invoke (delegated) or Claims.Invoke.Application (application).
CLAIMS_API_AUDIENCE=
# Explicit comma-separated caller application/client GUIDs, not object/principal IDs.
CLAIMS_API_CLIENT_IDS=
# Separate single-tenant SPA client GUID; must also appear in CLAIMS_API_CLIENT_IDS.
# Grant its delegated api://<CLAIMS_API_AUDIENCE>/claims.invoke permission explicitly.
# Register the exact deployed HTTPS root URL (with trailing /) as its SPA redirect.
CLAIMS_UI_CLIENT_ID=

# Local mode stays fixture-based; the Container App template explicitly sets azure.
CLAIMS_MODE=local
# Nonsecret outputs populated by infrastructure provisioning, not hand-picked fallbacks.
AZURE_RUNTIME_CLIENT_ID=
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=synthetic-policies
AZURE_STORAGE_ACCOUNT_NAME=
