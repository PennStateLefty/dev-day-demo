{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "appName": { "value": "${AZURE_CLAIMS_API_NAME}" },
    "environmentResourceId": { "value": "${AZURE_CONTAINER_APPS_ENVIRONMENT_ID}" },
    "runtimeIdentityId": { "value": "${AZURE_RUNTIME_IDENTITY_ID}" },
    "runtimeClientId": { "value": "${AZURE_RUNTIME_CLIENT_ID}" },
    "registryEndpoint": { "value": "${AZURE_CONTAINER_REGISTRY_ENDPOINT}" },
    "imageName": { "value": "${SERVICE_CLAIMS_API_IMAGE_NAME}" },
    "tenantId": { "value": "${AZURE_TENANT_ID}" },
    "apiAudience": { "value": "${CLAIMS_API_AUDIENCE}" },
    "apiClientIds": { "value": "${CLAIMS_API_CLIENT_IDS}" },
    "foundryProjectClientId": { "value": "${FOUNDRY_PROJECT_CLIENT_ID}" },
    "uiClientId": { "value": "${CLAIMS_UI_CLIENT_ID}" },
    "sqlServer": { "value": "${AZURE_SQL_SERVER}" },
    "sqlDatabase": { "value": "${AZURE_SQL_DATABASE}" },
    "searchEndpoint": { "value": "${AZURE_SEARCH_ENDPOINT}" },
    "searchIndex": { "value": "${AZURE_SEARCH_INDEX}" },
    "storageAccountName": { "value": "${AZURE_STORAGE_ACCOUNT_NAME}" },
    "gatewayName": { "value": "${AZURE_APIM_NAME}" },
    "visionEndpoint": { "value": "${CLAIMS_VISION_ENDPOINT=}" },
    "visionDeployment": { "value": "${CLAIMS_VISION_DEPLOYMENT=}" },
    "visionModelVersion": { "value": "${CLAIMS_VISION_MODEL_VERSION=}" },
    "foundryProjectEndpoint": { "value": "${FOUNDRY_PROJECT_ENDPOINT=}" },
    "claimAssessorVersion": { "value": "${CLAIM_ASSESSOR_AGENT_VERSION=}" },
    "applicationInsightsName": { "value": "${AZURE_APPLICATION_INSIGHTS_NAME}" }
  }
}
