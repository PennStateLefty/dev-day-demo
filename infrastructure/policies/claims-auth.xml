<policies>
  <inbound>
    <base />
    <validate-jwt header-name="Authorization" require-scheme="Bearer" require-expiration-time="true" require-signed-tokens="true" failed-validation-httpcode="401" failed-validation-error-message="A valid claims API bearer token is required." output-token-variable-name="claimsToken">
      <openid-config url="https://login.microsoftonline.com/__TENANT__/v2.0/.well-known/openid-configuration" />
      <audiences><audience>__AUDIENCE__</audience></audiences>
      <issuers><issuer>https://login.microsoftonline.com/__TENANT__/v2.0</issuer></issuers>
      <required-claims>
        <claim name="tid" match="all"><value>__TENANT__</value></claim>
        <claim name="ver" match="all"><value>2.0</value></claim>
        <claim name="azp" match="any">__CLIENTS__</claim>
      </required-claims>
    </validate-jwt>
    <choose>
      <when condition='@{
        var token = (Jwt)context.Variables["claimsToken"];
        var scopes = String.Join(" ", token.Claims.GetValueOrDefault("scp", new string[0])).Split((char)32);
        var roles = token.Claims.GetValueOrDefault("roles", new string[0]);
        return !(scopes.Contains("claims.invoke") || roles.Contains("Claims.Invoke.Application"));
      }'>
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-body>Claims tool permission is required.</set-body>
        </return-response>
      </when>
    </choose>
    <rate-limit-by-key calls="60" renewal-period="60" counter-key='@(((Jwt)context.Variables["claimsToken"]).Claims["azp"].First())' />
    <set-header name="x-correlation-id" exists-action="override">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
  </inbound>
  <backend>
    <forward-request buffer-response="false" timeout="120" />
  </backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
